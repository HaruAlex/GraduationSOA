# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

# Student Service APIs
GET     /api/students               controllers.StudentController.getAll()
GET     /api/students/:id           controllers.StudentController.getById(id: String)
POST    /api/students               controllers.StudentController.create(request: Request)
PUT     /api/students/:id           controllers.StudentController.update(id: String, request: Request)
DELETE  /api/students/:id           controllers.StudentController.delete(id: String)