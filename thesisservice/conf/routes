# This file defines all application routes (Higher priority routes first)

GET     /api/theses              controllers.ThesisController.getAll
GET     /api/theses/:maDT        controllers.ThesisController.getById(maDT: String)
POST    /api/theses              controllers.ThesisController.create(request: Request)
PUT     /api/theses/:maDT        controllers.ThesisController.update(maDT: String, request: Request)
DELETE  /api/theses/:maDT        controllers.ThesisController.delete(maDT: String)

GET     /                           controllers.HomeController.index()
GET     /assets/*file               controllers.Assets.versioned(path = "/public", file: Asset)